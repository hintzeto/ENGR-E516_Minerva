# ==========================================
# Project Minerva - Langflow
# VM: minerva-agents
# ==========================================

# Host-side private IP used by Docker Compose port publishing.
# This is a Compose variable, not a Langflow setting.
AGENTS_PRIVATE_IP=REPLACE_WITH_AGENTS_PRIVATE_IP

# Langflow server
LANGFLOW_HOST=0.0.0.0
LANGFLOW_PORT=7860
LANGFLOW_LOG_LEVEL=INFO
LANGFLOW_CONFIG_DIR=/app/langflow

# Langflow authentication
LANGFLOW_AUTO_LOGIN=false
LANGFLOW_SUPERUSER=minerva_admin
LANGFLOW_SUPERUSER_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
LANGFLOW_SECRET_KEY=REPLACE_WITH_GENERATED_SECRET
LANGFLOW_ENABLE_SIGNUP=false
LANGFLOW_NEW_USER_IS_ACTIVE=false

# Langflow execution
LANGFLOW_WORKERS=1
LANGFLOW_JOB_QUEUE_TYPE=asyncio

# External PostgreSQL application database on minerva-db
LANGFLOW_DATABASE_URL=postgresql://langflow_user:REPLACE_WITH_DB_PASSWORD@DB_PRIVATE_IP:5432/minerva_langflow?sslmode=disable

# Allow trusted internal services
LANGFLOW_SSRF_ALLOWED_HOSTS=<INFERENCE_INTERNAL_PORT>
