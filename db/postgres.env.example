# Copy to .env on the database VM. Keep .env out of Git.

# For reproducible use, pin a specific tag instead of the major version.
POSTGRES_IMAGE=pgvector/pgvector:pg16

POSTGRES_USER=minerva
POSTGRES_DB=minerva

# Change this to a long random value (openssl rand -hex 32).
POSTGRES_PASSWORD=replace-this-with-a-long-random-secret

# This VM's private IP. Use 127.0.0.1 only for same-VM testing.
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_HOST_PORT=5432
