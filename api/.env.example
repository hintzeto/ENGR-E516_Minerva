# Copy to api/.env (never commit .env). One KEY=value per line, no quotes.
# vLLM on Jetstream2: OPENAI_BASE_URL=http://<inference-vm-private-ip>:8000/v1, key = VLLM_API_KEY
# Gemini: OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
REQUEST_TIMEOUT_SECONDS=120