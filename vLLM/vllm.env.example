# Copy to .env on minerva-inference-test. Keep .env out of Git.

# Official generic x86_64 CPU image. For reproducible use, replace latest with a tested version tag.
VLLM_IMAGE=vllm/vllm-openai-cpu:latest-x86_64

# Small model for a CPU smoke test. First start downloads the model weights.
VLLM_MODEL_ID=Qwen/Qwen3-0.6B

# minerva-inference-test private IP. Use 127.0.0.1 only for same-VM testing.
VLLM_BIND_IP=10.4.36.241
VLLM_HOST_PORT=8000

# Change this to a long random value. Clients must send it as a Bearer token.
VLLM_API_KEY=replace-this-with-a-long-random-secret

# CPU-friendly test settings. Milan may not meet vLLM's current documented AMD CPU requirements.
VLLM_DTYPE=float32
VLLM_MAX_MODEL_LEN=2048
VLLM_MAX_NUM_SEQS=1
VLLM_CPU_KVCACHE_SPACE=2
VLLM_CPU_OMP_THREADS_BIND=auto

# Optional. Only required for gated Hugging Face models.
HF_TOKEN=